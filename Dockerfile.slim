# --- Build stage: compile native extensions ---
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libhdf5-dev \
    libnetcdf-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app

RUN uv init --no-readme && \
    uv add esgvoc esgprep cc-plugin-wcrp cmip7-repack && \
    uv add pyudunits2

# Pre-download esgvoc controlled vocabularies
RUN uv run esgvoc use cmip7@latest && \
    uv run esgvoc use cmip6@latest && \
    uv run esgvoc use cordex-cmip6@latest && \
    uv run esgvoc use universe@latest

# Trim: remove packages only needed at build/import time
RUN uv run pip uninstall -y sympy mpmath && \
    find /app/.venv -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    find /app/.venv -name '*.pyc' -delete 2>/dev/null; \
    find /app/.venv -name '*.pyi' -delete 2>/dev/null; \
    find /app/.venv -type d -name tests -exec rm -rf {} + 2>/dev/null; \
    find /app/.venv -type d -name test -exec rm -rf {} + 2>/dev/null; \
    true

# --- Runtime stage: no uv, no compilers, no dev headers ---
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libhdf5-310 \
    libhdf5-hl-310 \
    libnetcdf22 \
    hdf5-tools \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app /app
COPY --from=builder /root/.local/share/esgvoc /root/.local/share/esgvoc

WORKDIR /app
ENV USER=root
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

CMD ["bash"]
